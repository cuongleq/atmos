# ATMOS Environment Variables
# Copy this file to .env and fill in your values

# Sentry Error Tracking
# Get your DSN from https://sentry.io/settings/<project>/keys/
VITE_SENTRY_DSN=https://your-public-key@o123456.ingest.sentry.io/123456
VITE_SENTRY_TRACES_RATE=0.1
VITE_SENTRY_PROFILES_RATE=0.0
VITE_SENTRY_TRACING=true
VITE_SENTRY_PROFILING=false

# App Version
VITE_APP_VERSION=1.0.0